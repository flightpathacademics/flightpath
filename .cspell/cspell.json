{
  "version": "0.2",
  "language": "en-US",

    "files": [
      "**/*.php",
      "**/*.class",
      "**/*.inc",
      "**/*.js",
      "**/*.md",
      "**/*.txt",
      "**/*.html"
    ],


  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "ignore-words.txt",
      "addWords": true
    }
  ],

  "dictionaries": [
    "project-words"
  ],



  "ignorePaths": [
    ".git/**",
    ".github/**",
    "**/vendor/**",
    "**/lib/**",
    "libraries/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.css"
  ],

  "ignoreRegExpList": [
    "/https?:\\/\\/\\S+/",
    "/[A-Fa-f0-9]{32,}/",
    "/\\$[A-Za-z_][A-Za-z0-9_]*/",
    "/\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()/",
    "/\\b[A-Za-z_][A-Za-z0-9_]*\\s*\\([^)]*\\)/",
    "/https?:\\/\\/\\S+/",
    "/\\b[A-Za-z0-9_]*_[A-Za-z0-9_]*\\b/",
    "/[A-Za-z0-9_-]{20,}/"
  ]
}